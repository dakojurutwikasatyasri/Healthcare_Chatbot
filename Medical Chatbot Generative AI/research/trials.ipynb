   "source": [
    "from langchain_openai import AzureChatOpenAI\n",
    "from langchain.chains import ConversationalRetrievalChain\n",
    "\n",
    "# Initialize Azure OpenAI LLM for GPT-35-Turbo (Chat-based model)\n",
    "llm = AzureChatOpenAI(\n",
    "    azure_endpoint=\\",\n",
    "    api_key=\"\",\n",
    "    azure_deployment=\"",\n",
    "    api_version=\"\",\n",
    "    temperature=0.4,\n",
    "    max_tokens=500\n",
    ")\n",
    "\n",
    "# Initialize RAG Chain (ensure `retriever` is defined)\n",
    "rag_chain = ConversationalRetrievalChain.from_llm(llm, retriever=retriever)\n",
    "\n",
    "# Initialize chat history\n",
    "chat_history = []\n",
    "\n",
    "# Invoke RAG Chain\n",
    "response = rag_chain.invoke({\n",
    "    \"question\": \"What is Acromegaly and gigantism?\",\n",
    "    \"chat_history\": chat_history\n",
    "})\n",
    "\n",
    "# Print the answer\n",
    "print(response[\"answer\"])\n"
   ]
  },
